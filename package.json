{
  "name": "@medusajs/event-bus-sqs",
  "version": "1.0.0",
  "description": "SQS Event Bus Module for Medusa",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Mihai Jiplea",
  "type": "commonjs",
  "scripts": {
    "build": "rimraf dist && tsc --build",
    "test": "jest --passWithNoTests --testPathPattern=src",
    "test:integration": "jest --passWithNoTests --no-cache --bail --detectOpenHandles --forceExit --logHeapUsage --testPathPattern=\"integration-tests/__tests__/.*\\.spec\\.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0"
  },
  "devDependencies": {
    "@medusajs/framework": "2.13.1",
    "@medusajs/test-utils": "^2.13.1",
    "@medusajs/types": "^2.13.1",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.13.1"
  }
}
